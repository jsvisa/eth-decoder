# Backend API endpoint (hidden from frontend)
BACKEND_URL=http://x.y.z.z
# The API key used to authenticate writes to the backend is configured in the
# Settings page (Backend API Key), not in this file.

# Pro API key support for /api/simulate-tx
# Comma-separated list of valid pro API keys
# PRO_API_KEYS=sk-pro-xxx,sk-pro-yyy
# Base64-encoded JSON map of chainId -> RPC URL, auto-managed by
# .github/workflows/update-pro-rpc.yml (daily cron + manual trigger)
# PRO_RPC_CONFIG=

# Max size (in bytes) for a saved simulation result; larger payloads are
# rejected with 413. Defaults to 2097152 (2MB).
# MAX_SIMULATION_RESULT_BYTES=2097152
